---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>

  <!-- Styles for the calling card section -->
  <style>
    #callingCard {
      background: var(--text);
      color: var(--background);
      padding: 1em;
      margin-bottom: 3em;
    }

    #callingCard h2 {
      font-size: var(--heading);
      margin: 0;
    }

    #bodyText section h3 {
      background: var(--background-contrast);
      padding: .5em;
    }

    #aboutMe h3 {
      color: var(--deco-pink);
    }

    #previousClients h3 {
      color: var(--deco-purple);
    }

    #letsTalk h3 {
      color: var(--deco-green);
    }

    section p {
      padding-left: .5em;
    }

    #previousClients ul {
      list-style-type: none;
      padding-left: 1em;
    }
  </style>
  
	<body>
		<Header />
    <main>
      <section id="callingCard">
        <h1>Ren Blanding</h1>
        <h2>Product UX/UI Designer</h2>
        <h2>@ Keurig Dr Pepper</h2>
        <h2>Based in Chicago, IL</h2>
        <button>View My Projects</button>
      </section>

      <section id="bodyText">
        <section id="aboutMe">
          <h3>About Me</h3>
          <p>Currently designing user interfaces and user flows for Keurig’s Lineup of commercial and consumer smart brewers. Formerly led design system creation, with previous design system experience with the American Academy of Pediatrics and National Association of Corporate Directors. Experienced working closely with developers and designers.</p>
        <p>When I’m not at work I volunteer, climb, and work on my homelab (welcome to my IDE theme!).</p>
        </section>

        <section id="previousClients">
          <h3>Previous Clients</h3>
          <ul>
            <li>American Academy of Pediatrics (AAP)</li>
            <li>National Association of Corporate Directors (NACD)</li>
            <li>Spartan Chemical</li>
          </ul>
        </section>
        
        <section id="letsTalk">
          <h3>Let's Talk!</h3>
          <p>You can reach me anytime between normal business hours in the Central Time Zone. I am available through the following: </p>
          <ul>
            <li>Email - <a href="mailto:hello@blandingdesign.com">hello@blandingdesign.com</a></li>
            <li>LinkedIn - <a href="https://linkedin.com/blandingr">blandingr</a></li>
            <li>GitHub - <a href="https://github.com/hakata-jpn">hakata-jpn</a></li>
          </ul>
        </section>
      </section>
        <!-- TODO: Add time zone PLEASE, using MDN's Temporal 
      <p>
        It is currently () in Chicago right now. 
      </p>  -->
		</main>
	</body>
</html>
